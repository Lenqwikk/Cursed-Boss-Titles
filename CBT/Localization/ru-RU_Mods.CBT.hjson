	SquirrelIntro.TextToDisplay:
		'''
		Последстие пьянки
		Троянская белка
		'''

	MutantIntro: {
		TextToDisplay:
			'''
			Ебатель всех игроков террарии
			Мутант
			'''
		MasochistText:
			'''
			Тебе пизда
			Мутант
			'''
	}

	AbomIntro.TextToDisplay:
		'''
		Что за
