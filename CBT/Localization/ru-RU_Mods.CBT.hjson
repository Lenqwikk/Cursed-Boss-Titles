BossIntros: {

	// Vanilla //
	
	EyeOfCthulhuIntro.TextToDisplay:
		'''
		Шоколадный Глазик Лунного Лорда
		Глаз Ктулху
		'''
	KingSlimeIntro.TextToDisplay:
		'''
		Ожившая сперма из носка
		Король слизней
		'''
	EaterOfWorldsIntro.TextToDisplay:
		'''
		Глист Габена
		Пожиратель миров
		'''
	BrainOfCthulhuIntro.TextToDisplay:
		'''
		Нейронный пиздец
		Мозг ктулху
		'''
	QueenBeeIntro.TextToDisplay:
		'''
		Мамка твоего друга
		Королева пчел
		'''
	SkeletronIntro.TextToDisplay:
		'''
		Санс на стероидах
		Скелетрон
		'''
	WallOfFleshIntro.TextToDisplay:
		'''
		Прошлогодний Бифштекс
		Стена Плоти
		'''
	TwinsIntro.TextToDisplay:
		'''
		Яички Лунного Лорда
		Близнецы
		'''
